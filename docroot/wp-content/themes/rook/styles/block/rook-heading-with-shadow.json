{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"title": "Rook Headline With Shadow",
	"slug": "text-rook-headline-with-shadow",
	"blockTypes": ["core/heading", "core/paragraph"],
	"styles": {
		"typography": {
			"fontSize": "clamp(2.2rem, 2.2rem + ((1vw - 0.2rem) * 1.333), 3.5rem)",
			"lineHeight": "1.2"
		},
		"color": {
			"text": "var:preset|color|purple"
		},
		"css": "text-shadow: 3px 1px 2px var(--wp--preset--color--yellow, #ffea00);"

	}
}